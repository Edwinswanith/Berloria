MONGODB_URI=mongodb://127.0.0.1:27017/rarely

# Staff sign-in for /admin (one shared login in v1)
ADMIN_EMAIL=admin@berloria.example
ADMIN_PASSWORD=change-me-to-a-long-password
# Signs the admin session cookie. At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=

# Google Gemini key for the AI photo studio. Leave empty to run the studio in sample mode.
GEMINI_API_KEY=
# Optional overrides
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# GEMINI_IMAGE_SIZE=2K

# Razorpay online payments (UPI, cards, netbanking). Leave both empty to offer cash on delivery only.
# Use rzp_test_... keys while testing; switch to live keys only at launch.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
