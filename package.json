{
  "name": "ecommers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "db": "tsx scripts/dev-db.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "art": "tsx scripts/product-art.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:clean": "tsx --env-file=.env.local scripts/clear-test-orders.ts"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "mongoose": "^9.12.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "mongodb-memory-server": "^11.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
